{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    // chafa -f sixel -s 40x20 ~/Pictures/your_catgirl.png > ~/.config/fastfetch/catgirl.sixel
    "type": "raw",        // Logo type: auto, builtin, small, file, etc.
    "source": "/home/usera/Pictures/image.sixel",      // Built-in logo name or file path
    "width": 40,           // Width in characters
    "height": 20,          // Height in characters
    "padding": {
        "top": 0,          // Top padding
        "left": 2,         // Left padding
        "right": 2,        // Right padding
    }
    // "color": {             // Override logo colors
    //     "1": "blue",
    //     "2": "green"
    // }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
